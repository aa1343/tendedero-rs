{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tendedero",
  "version": "1.1.1",
  "identifier": "com.tendedero.rs",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tendedero",
        "label": "main",
        "url": "index.html",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "x": 0,
        "y": 0,
        "width": 1920,
        "height": 480,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
